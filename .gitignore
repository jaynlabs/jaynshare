# Client bundles written by deploy/server/prepare-client.sh. These carry
# enrollment material for a named person; the directory is ignored wholesale so
# a stray bundle can never be added by a wildcard `git add`.
onboarding/

# Working notes and planning documents. Deliberately local-only: each
# maintainer keeps their own, and they are not part of the published project.
plans/

